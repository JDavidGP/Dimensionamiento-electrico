# Copiar a .env y completar — .env nunca se comitea (ver .gitignore).

# postgres://usuario:password@host:5432/nombre_db
DATABASE_URL=postgres://dec:dec@localhost:5432/dec

# Generar uno real con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del backend (opcional, default 3001)
PUERTO=3001

# Origen del frontend para CORS (opcional, default * — restringir en producción)
ORIGEN_PERMITIDO=http://localhost:5173
