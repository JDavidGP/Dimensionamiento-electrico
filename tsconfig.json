{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    // Migración incremental (usuario, 2026-11-21, "ya después podés
    // TypeScript", empezando por los módulos puros): conviven .js/.jsx
    // (todavía sin tipar, allowJs sin checkJs) y .ts/.tsx (tipado
    // estricto) mientras dure la migración, módulo por módulo — nunca
    // un cambio de una sola vez. Cada archivo YA migrado a .ts/.tsx
    // queda bajo el `strict` de abajo; lo que sigue en .js no se toca
    // todavía.
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
